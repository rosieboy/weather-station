ORIGIN=http://localhost:3000
# Use Home Assistant's LAN IP if .local does not resolve inside Docker.
HOME_ASSISTANT_URL=http://homeassistant.local
HOME_ASSISTANT_TOKEN=
HA_BALCONY_TEMPERATURE=sensor.example_balcony_temperature
HA_BALCONY_HUMIDITY=sensor.example_balcony_humidity
HA_ROOM_NAME=Vardagsrum
HA_ROOM_TEMPERATURE=sensor.example_living_room_temperature
HA_ROOM_HUMIDITY=sensor.example_living_room_humidity
HA_BEDROOM_TEMPERATURE=sensor.example_bedroom_temperature
HA_BEDROOM_HUMIDITY=sensor.example_bedroom_humidity

# Optional: weather and astronomy from Home Assistant
HA_WEATHER_ENTITY=weather.forecast_hem
HA_MOON_ENTITY=sensor.moon_fas
